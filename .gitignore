# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment variables — ignore every .env variant, keep only the examples.
# The broad pattern matters: .env.production and similar hold real secrets.
!.env.example
!.env.local.example

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Backend build output
dist/
build/

# Prisma
backend/prisma/migrations/dev.db

# Testing
coverage/

# macOS
.DS_Store

# VS Code — ignore personal settings, but share workspace config with the team
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
config.bat
