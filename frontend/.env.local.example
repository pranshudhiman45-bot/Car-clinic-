# Base URL of the backend REST API (Express server)
# To test on a real phone, use your machine's LAN IP instead of localhost --
# on a phone "localhost" means the phone itself. Find it with:
#   ipconfig getifaddr en0
# e.g. NEXT_PUBLIC_API_URL=http://192.168.1.32:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL, used for SEO metadata (canonical URL, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
