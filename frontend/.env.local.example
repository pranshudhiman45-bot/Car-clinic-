# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# WARNING: every NEXT_PUBLIC_* value is embedded in the JavaScript sent to the
# browser and is therefore PUBLIC. Never put an API secret, private key, or
# password in a NEXT_PUBLIC_* variable. Private values belong in the backend.
# =============================================================================


# -----------------------------------------------------------------------------
# PHASE 1 — REQUIRED NOW
# -----------------------------------------------------------------------------

# Base URL of the backend REST API.
# To test on a real phone, use your machine's LAN IP instead of localhost --
# on a phone "localhost" means the phone itself. Find it with:
#   ipconfig getifaddr en0
# e.g. NEXT_PUBLIC_API_URL=http://192.168.1.32:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public site URL — used for canonical URLs, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# PHASE 6 — ON-DEMAND ISR REVALIDATION
# Must match REVALIDATE_SECRET in the backend. NOT prefixed with NEXT_PUBLIC_,
# because it is a secret and must stay server-side.
# -----------------------------------------------------------------------------

# REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# PHASE 7 — PAYMENTS
# Only the PUBLIC Razorpay key id belongs here (it is safe to expose).
# RAZORPAY_KEY_SECRET must NEVER appear in the frontend.
# -----------------------------------------------------------------------------

# NEXT_PUBLIC_RAZORPAY_KEY_ID=


# -----------------------------------------------------------------------------
# PHASE 9 — SEO / ANALYTICS / MAPS (optional)
# -----------------------------------------------------------------------------

# Google Maps embed on the contact page. Restrict the key by HTTP referrer
# in Google Cloud Console, since it is publicly visible.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
# NEXT_PUBLIC_GA_ID=

# Google Search Console verification token
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
