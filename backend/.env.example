# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_wash_platform?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Auth (used by the prepared authentication architecture, not yet active)
JWT_SECRET=replace-with-a-long-random-string

# CORS - URL of the frontend app
FRONTEND_URL=http://localhost:3000

