# =============================================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Variables are grouped by the phase that first needs them. Anything commented
# out is not required yet; the app starts fine without it.
# =============================================================================


# -----------------------------------------------------------------------------
# PHASE 1 — REQUIRED NOW. The server will not start without these.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local:      postgresql://USER@localhost:5432/car_wash_platform?schema=public
# Production: use the pooled connection string from Supabase/Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_wash_platform?schema=public"

PORT=4000
NODE_ENV=development

# Signing secret for auth tokens. Must be long and random — generate with:
#   openssl rand -base64 48
# Use a DIFFERENT value in production than in development.
JWT_SECRET=replace-with-a-long-random-string

# Allowed frontend origin(s) for CORS, comma-separated.
# To test on a real phone over Wi-Fi, add your machine's LAN IP:
#   FRONTEND_URL=http://localhost:3000,http://192.168.1.32:3000
FRONTEND_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# PHASE 3 — AUTHENTICATION (customer OTP via SMS/WhatsApp)
# -----------------------------------------------------------------------------

# How long an access token stays valid.
# JWT_EXPIRES_IN=7d

# OTP settings
# OTP_LENGTH=6
# OTP_EXPIRY_MINUTES=10

# --- Pick ONE SMS/OTP provider ---

# Option A: MSG91 (widely used in India, good OTP delivery rates)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=

# Option B: Twilio (global, more expensive for Indian numbers)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Option C: Fast2SMS (India, simple pricing)
# FAST2SMS_API_KEY=


# -----------------------------------------------------------------------------
# PHASE 6 — ON-DEMAND ISR REVALIDATION
# Lets the admin panel tell the Next.js site to refresh cached pages when a
# price/service/offer is published. Generate with: openssl rand -base64 32
# Must match REVALIDATE_SECRET on the frontend.
# -----------------------------------------------------------------------------

# REVALIDATE_SECRET=


# -----------------------------------------------------------------------------
# PHASE 7 — PAYMENTS (Razorpay)
# Start the business KYC early — approval is manual and can take several days.
# Use test-mode keys (rzp_test_...) during development.
# -----------------------------------------------------------------------------

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Needed to verify incoming payment webhooks are genuinely from Razorpay:
# RAZORPAY_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# PHASE 7 — WHATSAPP NOTIFICATIONS
# -----------------------------------------------------------------------------

# Option A: Meta WhatsApp Cloud API (direct, cheapest at volume)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# Option B: A provider such as Interakt / Gupshup / AiSensy
#   (easier onboarding and template approval, higher per-message cost)
# WHATSAPP_API_KEY=
# WHATSAPP_API_URL=


# -----------------------------------------------------------------------------
# PHASE 7 — EMAIL NOTIFICATIONS
# -----------------------------------------------------------------------------

# Option A: Resend (simplest setup)
# RESEND_API_KEY=

# Option B: Plain SMTP (Gmail, Zoho, your host)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Sender identity shown to customers (needed with either option)
# EMAIL_FROM="ShineWorks <bookings@yourdomain.com>"


# -----------------------------------------------------------------------------
# STORAGE — CLOUDFLARE R2 (gallery and service images)
# Needed once the admin panel supports image upload (Phase 4).
# -----------------------------------------------------------------------------

# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=
# Public base URL images are served from (custom domain or r2.dev URL):
# CLOUDFLARE_R2_PUBLIC_URL=


# -----------------------------------------------------------------------------
# NOTE — business details are NOT environment variables.
# Business name, address, phone, opening hours, prices and similar are managed
# by the owner through the admin panel and stored in the database, so they can
# be changed without a redeploy. Do not add them here.
# -----------------------------------------------------------------------------
