generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Queries go through this. With Supabase this is the pooled (pgBouncer)
  // connection; locally it is just the direct connection.
  url      = env("DATABASE_URL")
  // Migrations cannot run through a connection pooler, so they need a direct
  // connection. Locally, set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  WORKER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum VehicleType {
  HATCHBACK
  SEDAN
  SUV
  MUV
  LUXURY
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  worker   Worker?
  vehicles Vehicle[]
  bookings Booking[]
  reviews  Review[]
}

// Extends a User with WORKER role. Working-hours and skill-level detail
// are intentionally left for the database-design phase.
model Worker {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills       Service[]
  bookings     Booking[]
  blockedDates BlockedDate[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]
}

model Service {
  id              String   @id @default(cuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  name            String
  slug            String   @unique
  description     String?
  basePrice       Decimal
  durationMinutes Int
  requiredWorkers Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  packages ServicePackage[]
  workers  Worker[]
  bookings Booking[]
}

model ServicePackage {
  id              String   @id @default(cuid())
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  name            String
  price           Decimal
  durationMinutes Int?
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Vehicle {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  type        VehicleType
  make        String?
  model       String?
  plateNumber String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bookings Booking[]
}

// Worker assignment and multi-service line items are intentionally simple
// (implicit many-to-many) at this stage; quantity/price snapshots etc.
// belong to the database-design phase.
model Booking {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id])
  status      BookingStatus @default(PENDING)
  bookingDate DateTime
  startTime   DateTime
  endTime     DateTime
  totalAmount Decimal
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  services Service[]
  workers  Worker[]
  payment  Payment?
  review   Review?
}

model Offer {
  id              String    @id @default(cuid())
  title           String
  description     String?
  discountPercent Int?
  discountAmount  Decimal?
  code            String?   @unique
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  imageUrl  String
  caption   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessHours {
  id        String    @id @default(cuid())
  dayOfWeek DayOfWeek @unique
  openTime  String
  closeTime String
  isClosed  Boolean   @default(false)
}

// A closed business day (workerId null) or a single worker's leave/unavailability (workerId set).
model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String?
  workerId  String?
  worker    Worker?  @relation(fields: [workerId], references: [id])
  createdAt DateTime @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  amount      Decimal
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
